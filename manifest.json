{
  "manifest_version": 3,
  "name": "Meshy Downloader",
  "version": "1.2",
  "description": "Télécharge les modèles 3D Meshy (CC0) directement depuis la visionneuse",
  "permissions": ["scripting", "downloads", "activeTab"],
  "host_permissions": ["https://*.meshy.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://*.meshy.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meshy Downloader"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["https://*.meshy.ai/*"]
    }
  ],
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
